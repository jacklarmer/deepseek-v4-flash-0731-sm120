# Copy to .env and edit. Never commit .env.
# Values below are the measured best on 4x RTX PRO 6000 Blackwell (SM120). See RESULTS.md.

COMPOSE_PROJECT_NAME=ds4-flash-0731
MODEL_DIR=/path/to/DeepSeek-V4-Flash-0731
PORT=8000

GPU_MEM_UTIL=0.90
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
MAX_CUDAGRAPH=48

# 16 is INVALID for the DS-MLA layout (KV page-size assert several minutes into boot).
BLOCK_SIZE=256

# All three measured and reverted; each lost to the defaults on SM120. See RESULTS.md.
BREAKABLE_CUDAGRAPH=1
MOE_FORCE_A16=0
WO_PROJECTION=0

# Read from a mode-0600 file at runtime; never paste a literal here.
#   IFS= read -r VLLM_API_KEY < ~/.config/inference-api-key; export VLLM_API_KEY
VLLM_API_KEY=
