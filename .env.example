# Copy to .env and edit. Never commit .env.

IMAGE=voipmonitor/vllm:gilded-gnosis-v20-vllm1e9c9c3-sieec30ff-fi801d57a-cu132-20260731-r16
NAME=ds4-0731

# Absolute path to the local checkpoint directory (deepseek-ai/DeepSeek-V4-Flash-0731).
MODEL_ROOT=/path/to/DeepSeek-V4-Flash-0731

PORT=8000
GPUS=0,1,2,3
TP_SIZE=4

BACKEND=b12x-a8
ALLREDUCE_MODE=b12x
DSPARK_TOKENS=5
DSPARK_DEPTH_MODE=fixed
DRAFT_SAMPLE_METHOD=probabilistic

MAX_NUM_SEQS=16
MAX_MODEL_LEN=262144
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.95

LOAD_FORMAT=instanttensor
INSTANTTENSOR_BACKEND=BUFFERED
KV_OFFLOADING_SIZE=0

JIT_CACHE=./cache

# Read this from a mode-0600 file at runtime; do not paste a literal here.
# e.g.  IFS= read -r VLLM_API_KEY < ~/.config/inference-api-key; export VLLM_API_KEY
VLLM_API_KEY=

# Benchmarking only:
# EXTRA_VLLM_ARGS=--no-enable-prefix-caching
